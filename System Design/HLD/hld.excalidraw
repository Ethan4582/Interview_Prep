      "isDeleted": false,
      "boundElements": [],
      "updated": 1761802544972,
      "link": null,
      "locked": false,
      "text": "Non-Functional :\n- availability >> consistency\n- isolation and security when running user code\n- low latency return submission results < 5 seconds\n- handle 100k users for competitions\n",
