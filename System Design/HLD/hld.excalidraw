      "isDeleted": false,
      "boundElements": [],
      "updated": 1761658760188,
      "link": null,
      "locked": false,
      "text": "Functional :\n- Create/schedule a job (immediate, future, reoccurring)\n- Monitor the status of their jobs\n- Cancel or Reschedule jobs\n- Dependencies or DAGs\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- Create/schedule a job (immediate, future, reoccurring)\n- Monitor the status of their jobs\n- Cancel or Reschedule jobs\n- Dependencies or DAGs\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JLEpY4QKveBvXXdEIsuaK",
      "type": "text",
      "x": 41031.79661827484,
      "y": -5438.697688722831,
      "width": 471.8396911621094,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
