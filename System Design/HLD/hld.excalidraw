      "seed": 194208560,
      "version": 4817,
      "versionNonce": 982218032,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763096177926,
      "link": null,
      "locked": false,
      "text": "Functional :\n- should be able to search for businesses by name, location and category\n- should be able view businesses and their reviews\n- should be able to leave reviews on businesses",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- should be able to search for businesses by name, location and category\n- should be able view businesses and their reviews\n- should be able to leave reviews on businesses",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "x253yBTdSDNKTdl_dm2i6",
      "type": "text",
      "x": 136413.10419122316,
      "y": -9955.809269715253,
      "width": 449.3197021484375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "yCT4Mcw2trSUvLVvcEFuK",
        "njKXtpW9Yrc1AQSDPiUd3"
      ],
      "frameId": null,
      "index": "c0sS",
      "roundness": null,
      "seed": 866090288,
      "version": 3908,
      "versionNonce": 2070390064,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763096176196,
      "link": null,
      "locked": false,
      "text": "Non-Functional :\n- search operation with low latency (< 500ms)\n- availability >> consistency\n- handle 100M DAU and 10M businesses\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional :\n- search operation with low latency (< 500ms)\n- availability >> consistency\n- handle 100M DAU and 10M businesses\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
