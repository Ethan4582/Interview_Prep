    {
      "id": "0YfnJbSi3e_Djh6GO_7Om",
      "type": "text",
      "x": 69765.76674073805,
      "y": 10097.041916912918,
      "width": 469.1484375,
      "height": 1575,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Oa",
      "roundness": null,
      "seed": 312378235,
      "version": 114,
      "versionNonce": 2056016277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761809257535,
      "link": null,
      "locked": false,
      "text": "            ┌──────────────────────────┐\n            │ 1️⃣ Define Test Cases     │\n            │ - One universal set per  │\n            │   problem (JSON format)  │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 2️⃣ Serialize I/O Data    │\n            │ - Standardize input/output│\n            │   (e.g., arrays, trees)  │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 3️⃣ Select Language       │\n            │   Test Harness           │\n            │ - Language-specific code │\n            │   handles I/O & compare  │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 4️⃣ Setup Container       │\n            │ - Load user code +       │\n            │   harness + helper files │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 5️⃣ Deserialize Input     │\n            │ - Convert JSON → objects │\n            │   (e.g., TreeNode)       │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 6️⃣ Run User Code         │\n            │ - Call user function     │\n            │   with deserialized data │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 7️⃣ Serialize Output      │\n            │ - Convert result back to │\n            │   JSON / array format    │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 8️⃣ Compare Results       │\n            │ - Check against expected │\n            │   output for pass/fail   │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 9️⃣ Return Summary        │\n            │ - Pass/Fail per test case│\n            │ - Logs, runtime info etc │\n            └──────────────────────────┘\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "            ┌──────────────────────────┐\n            │ 1️⃣ Define Test Cases     │\n            │ - One universal set per  │\n            │   problem (JSON format)  │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 2️⃣ Serialize I/O Data    │\n            │ - Standardize input/output│\n            │   (e.g., arrays, trees)  │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 3️⃣ Select Language       │\n            │   Test Harness           │\n            │ - Language-specific code │\n            │   handles I/O & compare  │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 4️⃣ Setup Container       │\n            │ - Load user code +       │\n            │   harness + helper files │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 5️⃣ Deserialize Input     │\n            │ - Convert JSON → objects │\n            │   (e.g., TreeNode)       │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 6️⃣ Run User Code         │\n            │ - Call user function     │\n            │   with deserialized data │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 7️⃣ Serialize Output      │\n            │ - Convert result back to │\n            │   JSON / array format    │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 8️⃣ Compare Results       │\n            │ - Check against expected │\n            │   output for pass/fail   │\n            └────────────┬─────────────┘\n                         │\n                         ▼\n            ┌──────────────────────────┐\n            │ 9️⃣ Return Summary        │\n            │ - Pass/Fail per test case│\n            │ - Logs, runtime info etc │\n            └──────────────────────────┘\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
