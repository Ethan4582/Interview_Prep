    {
      "id": "0ECo3rf-77-kJmgg0R-om",
      "type": "text",
      "x": 15085.565826927945,
      "y": -4618.44412127576,
      "width": 560.9395751953125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
