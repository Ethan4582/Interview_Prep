      ],
      "frameId": null,
      "index": "bfS",
      "roundness": null,
      "seed": 1187825894,
      "version": 193,
      "versionNonce": 385304678,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761020360442,
      "link": null,
      "locked": false,
      "text": "- Push updates to client as soon\nas seat is booked or reserved by \nanother user without needing to\nrefresh the page.\n\n\n- Still this doesn't work well for \nvery very popular events",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Push updates to client as soon\nas seat is booked or reserved by \nanother user without needing to\nrefresh the page.\n\n\n- Still this doesn't work well for \nvery very popular events",
      "autoResize": true,
      "lineHeight": 1.25
    },
