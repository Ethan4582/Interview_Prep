    {
      "id": "EJuOnv9MXZOB0qJZOSNzD",
      "type": "text",
      "x": 136411.21466788137,
      "y": -10188.150028795275,
      "width": 712.99951171875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ngjzNqzJkfvYUycwGJb0D",
        "njKXtpW9Yrc1AQSDPiUd3"
      ],
      "frameId": null,
