    {
      "id": "xsfPm0gVA2jdXAf58djPl",
      "type": "text",
      "x": 12326.186736256293,
      "y": 4226.878160776154,
      "width": 501.59930419921875,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHg",
      "roundness": null,
      "seed": 1782314564,
      "version": 110,
      "versionNonce": 941242364,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755267877759,
      "link": null,
      "locked": false,
      "text": "Fingerprint for each file and\neach chunk in the file\n\n- Client chunks file (5–10 MB) & fingerprints \n  chunks + full file (`fileId`)\n- Client GETs `FileMetadata` \n  by `fileId` (resume if exists)\n- If not exists, client POSTs `/files/presigned-url`; \n  backend saves metadata (`uploading`)\n- Client uploads chunks to S3 via presigned URLs\n- S3 notifies backend; backend marks chunks `uploaded`\n- When all chunks uploaded, backend marks file `uploaded`\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fingerprint for each file and\neach chunk in the file\n\n- Client chunks file (5–10 MB) & fingerprints \n  chunks + full file (`fileId`)\n- Client GETs `FileMetadata` \n  by `fileId` (resume if exists)\n- If not exists, client POSTs `/files/presigned-url`; \n  backend saves metadata (`uploading`)\n- Client uploads chunks to S3 via presigned URLs\n- S3 notifies backend; backend marks chunks `uploaded`\n- When all chunks uploaded, backend marks file `uploaded`\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
