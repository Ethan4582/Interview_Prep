      "boundElements": [],
      "updated": 1754916506093,
      "link": null,
      "locked": false,
      "text": "1. Intital API to upload files will now change to 3 three process\n    - POST /files/presigned_url -> PresignedURL\n        {\n            FileMetadata\n        }\n     - Use PresignedURL to upload file via PUT request to Blog storage from client\n     - Once uploaded, on S3 Notifications to backend will update status in our MetadataDB",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Intital API to upload files will now change to 3 three process\n    - POST /files/presigned_url -> PresignedURL\n        {\n            FileMetadata\n        }\n     - Use PresignedURL to upload file via PUT request to Blog storage from client\n     - Once uploaded, on S3 Notifications to backend will update status in our MetadataDB",
      "autoResize": true,
      "lineHeight": 1.25
    },
