    {
      "id": "kq_Dka28GFYHQ2_IqqbJh",
      "type": "text",
      "x": 79349.56882238924,
      "y": 2762.348825189134,
      "width": 847,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Sw",
      "roundness": null,
      "seed": 1407540206,
      "version": 20,
      "versionNonce": 369011506,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762665560948,
      "link": null,
      "locked": false,
      "text": "Client-Side\n\nconst eventSource = new EventSource(`/api/auctions/${auctionId}/bid-stream`);\n\neventSource.onmessage = (event) => {\n  const { maxBid } = JSON.parse(event.data);\n  updateUI(maxBid);\n};",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client-Side\n\nconst eventSource = new EventSource(`/api/auctions/${auctionId}/bid-stream`);\n\neventSource.onmessage = (event) => {\n  const { maxBid } = JSON.parse(event.data);\n  updateUI(maxBid);\n};",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bgi5fubJsDEyK6IehQFtZ",
      "type": "text",
      "x": 79355.65017543842,
      "y": 3016.2871856572765,
      "width": 682,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Sx",
      "roundness": null,
      "seed": 347302898,
      "version": 16,
      "versionNonce": 459556850,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762665673662,
      "link": null,
      "locked": false,
      "text": "Server-Side\n\nclass AuctionEventManager {\n  private connections: Map<string, Set<Response>> = new Map();\n  \n  addConnection(auctionId: string, connection: Response) {\n    if (!this.connections.has(auctionId)) {\n      this.connections.set(auctionId, new Set());\n    }\n    this.connections.get(auctionId).add(connection);\n  }\n  \n  broadcastNewBid(auctionId: string, maxBid: number) {\n    const connections = this.connections.get(auctionId);\n    if (connections) {\n      const event = `data: ${JSON.stringify({ maxBid })}\\n\\n`;\n      connections.forEach(response => response.write(event));\n    }\n  }\n}",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Server-Side\n\nclass AuctionEventManager {\n  private connections: Map<string, Set<Response>> = new Map();\n  \n  addConnection(auctionId: string, connection: Response) {\n    if (!this.connections.has(auctionId)) {\n      this.connections.set(auctionId, new Set());\n    }\n    this.connections.get(auctionId).add(connection);\n  }\n  \n  broadcastNewBid(auctionId: string, maxBid: number) {\n    const connections = this.connections.get(auctionId);\n    if (connections) {\n      const event = `data: ${JSON.stringify({ maxBid })}\\n\\n`;\n      connections.forEach(response => response.write(event));\n    }\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
