    },
    {
      "id": "PsimOYAfGkdfub2OA-C-i",
      "type": "text",
      "x": 5763.165462318743,
      "y": -3796.235951208225,
      "width": 747.4794921875,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IQSW860ywbLS4hT70SALK"
      ],
      "frameId": null,
