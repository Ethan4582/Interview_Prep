      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- need to keep sharedfiles cache and sharelist\nin sync\n- to overcome this is to maintain user to file list\nmapping in same database and update both sharelist\nand sharedfiles in transaction",
      "autoResize": true,
      "lineHeight": 1.25
    },
