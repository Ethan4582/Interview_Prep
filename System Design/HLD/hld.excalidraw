      "updated": 1762690659007,
      "link": null,
      "locked": false,
      "text": "Functional :\n- should be able to view price history for amazon products\n- should be able to subscribe to price drop notifications with thresholds\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- should be able to view price history for amazon products\n- should be able to subscribe to price drop notifications with thresholds\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "96_D9J6l8oDG3DAQ2j7_E",
      "type": "text",
      "x": 87180.31460753448,
      "y": -7170.158555905369,
      "width": 527.1396484375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "tez5qZb5a0Bblcun2mTVi"
      ],
      "frameId": null,
      "index": "c0UK",
      "roundness": null,
      "seed": 438426482,
      "version": 3164,
      "versionNonce": 1264698610,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762691678964,
      "link": null,
      "locked": false,
      "text": "Non-Functional :\n- availability >>> consistency.\n- handle 500M products at scale.\n- price history queries < 500ms latency.\n- price drop notification within 1 hour of price change.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional :\n- availability >>> consistency.\n- handle 500M products at scale.\n- price history queries < 500ms latency.\n- price drop notification within 1 hour of price change.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
