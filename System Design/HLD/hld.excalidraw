    {
      "id": "2Sk6dOYRuqjzKrDE9y4Fg",
      "type": "text",
      "x": 41029.31439266654,
      "y": -5670.826761059588,
      "width": 540.57958984375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
