      "seed": 1011195657,
      "version": 256,
      "versionNonce": 662944841,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754787323691,
      "link": null,
      "locked": false,
      "text": "Functional :\n- users can create short urls from original urls, custom alias, expiration date\n- users can access original by browsing the short url",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- users can create short urls from original urls, custom alias, expiration date\n- users can access original by browsing the short url",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fyStKnFRsRSywc-ABeCMa",
      "type": "text",
      "x": 5762.651511734914,
      "y": -3694.700477495502,
      "width": 493.53973388671875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "IQSW860ywbLS4hT70SALK"
      ],
      "frameId": null,
      "index": "b3p",
      "roundness": null,
      "seed": 1323109257,
      "version": 513,
      "versionNonce": 1356581063,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754787323691,
      "link": null,
      "locked": false,
      "text": "Non Functional :\n- shortened urls should be unique\n- Latency (< 100 ms) for redirection\n- availability >> consistency\n- should be able to support 1B urls and 100M DAU",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional :\n- shortened urls should be unique\n- Latency (< 100 ms) for redirection\n- availability >> consistency\n- should be able to support 1B urls and 100M DAU",
      "autoResize": true,
      "lineHeight": 1.25
    },
