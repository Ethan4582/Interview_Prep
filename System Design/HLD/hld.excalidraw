      "isDeleted": false,
      "boundElements": [],
      "updated": 1761033787274,
      "link": null,
      "locked": false,
      "text": "- Fan-Out Problem : A single requests fans out to create many more requests.\n\n- Instinct - Can we compute feed results on write or post creation rather than\n            at the time we want to read their feed??",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Fan-Out Problem : A single requests fans out to create many more requests.\n\n- Instinct - Can we compute feed results on write or post creation rather than\n            at the time we want to read their feed??",
      "autoResize": true,
      "lineHeight": 1.25
    },
