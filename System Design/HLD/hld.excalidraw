      "updated": 1762913624506,
      "link": null,
      "locked": false,
      "text": "{\n    \"TableName\": \"comments\",\n    \"KeyConditionExpression\": \"liveVideoId = :liveVideoId AND commentId < :cursor\",\n    \"ExpressionAttributeValues\": {\n        \":liveVideoId\": \"liveVideoId\",\n        \":cursor\": \"last_comment_id\"\n    },\n    \"ScanIndexForward\": false,\n    \"Limit\": \"pageSize\"\n}",
      "fontSize": 16,
