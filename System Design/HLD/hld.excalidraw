    },
    {
      "id": "S0W9-2hqLKKay4ikK3ZFL",
      "type": "text",
      "x": 79711.70823155998,
      "y": -139.24090209249914,
      "width": 781,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Qp",
      "roundness": null,
      "seed": 1472844210,
      "version": 115,
      "versionNonce": 997451826,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762663363239,
      "link": null,
      "locked": false,
      "text": "1. Cache read and cache write atomically\n\n-- Lua script to atomically compare and set max bid\nlocal current_max_bid = tonumber(redis.call('GET', auction_key) or '0')\nlocal proposed_bid_amount = tonumber(proposed_bid)\n\nif proposed_bid_amount > current_max_bid then\n    redis.call('SET', auction_key, proposed_bid_amount)\n    return true\nelse\n    return false\nend",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Cache read and cache write atomically\n\n-- Lua script to atomically compare and set max bid\nlocal current_max_bid = tonumber(redis.call('GET', auction_key) or '0')\nlocal proposed_bid_amount = tonumber(proposed_bid)\n\nif proposed_bid_amount > current_max_bid then\n    redis.call('SET', auction_key, proposed_bid_amount)\n    return true\nelse\n    return false\nend",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ewJ1Asi8wL3koPGEIMWYu",
