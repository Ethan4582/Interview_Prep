      "seed": 40390351,
      "version": 482,
      "versionNonce": 165882703,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761709900165,
      "link": null,
      "locked": false,
      "text": "- Ad click is sent to the click processor service.\n- The click processor service writes the event to event store\n- Every 5 Minutes, a cron job kicks off spark job that read events from the event store and aggregates them.\n- The aggregated data is stored in an OLAP database for querying.\n- Advertisers can query the OLAP database to get metrics on their ads.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Ad click is sent to the click processor service.\n- The click processor service writes the event to event store\n- Every 5 Minutes, a cron job kicks off spark job that read events from the event store and aggregates them.\n- The aggregated data is stored in an OLAP database for querying.\n- Advertisers can query the OLAP database to get metrics on their ads.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "zLjvC0C4dLF-4ogyx3bpe",
      "type": "text",
      "x": 49782.876908039885,
      "y": 270.280560732607,
      "width": 563.19921875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c015",
      "roundness": null,
      "seed": 2088625039,
      "version": 139,
      "versionNonce": 236690639,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761709990251,
      "link": null,
      "locked": false,
      "text": "- Batch processing introduces significant delay in data pipeline\nand querying data is always at a couple minutes old.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Batch processing introduces significant delay in data pipeline\nand querying data is always at a couple minutes old.",
      "autoResize": true,
      "lineHeight": 1.25
    },
