      "type": "text",
      "x": 87189.8323404028,
      "y": -6607.96949238592,
      "width": 830.2379150390625,
      "height": 385.9660728663153,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
