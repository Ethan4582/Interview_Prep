      "updated": 1755392298874,
      "link": null,
      "locked": false,
      "text": "Functional :\n- View news from many publishers around the world\n- Scroll Infinitely\n- Onclick - redirect to article on publishers website\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- View news from many publishers around the world\n- Scroll Infinitely\n- Onclick - redirect to article on publishers website\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
