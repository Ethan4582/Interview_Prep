      "updated": 1755326512814,
      "link": null,
      "locked": false,
      "text": "Functional :\n- users can upload file\n- users can download file\n- users can share files\n- users can sync files across devices",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- users can upload file\n- users can download file\n- users can share files\n- users can sync files across devices",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xInxOe2wC4TFBnnrQTAo0",
