      "versionNonce": 614106031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761713134630,
      "link": null,
      "locked": false,
      "text": "5.4 low latency analytics queries < 1s",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
