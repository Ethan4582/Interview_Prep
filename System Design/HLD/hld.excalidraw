        }
      ],
      "updated": 1761722988847,
      "link": null,
      "locked": false,
      "text": "Efficiency\n\n- Don't crawl pages that have been crawled already (Simple MetadataDB lookup)\n- But what if different URLs point to the same page?? and also possible different\ndomains to have exactly the same content : so can't just compare urls but also content",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Efficiency\n\n- Don't crawl pages that have been crawled already (Simple MetadataDB lookup)\n- But what if different URLs point to the same page?? and also possible different\ndomains to have exactly the same content : so can't just compare urls but also content",
      "autoResize": true,
      "lineHeight": 1.25
    },
