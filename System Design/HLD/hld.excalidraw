      "updated": 1755402940334,
      "link": null,
      "locked": false,
      "text": "- Query now looks something like\nthis:\n\nWHERE (published_at, article_id) <\n(cursor_timestamp, cursor_id) ORDER\nBY published_at DESC, article_id \nDESC LIMIT 20.\n\n- composite index on (published_at,\n  article_id)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Query now looks something like\nthis:\n\nWHERE (published_at, article_id) <\n(cursor_timestamp, cursor_id) ORDER\nBY published_at DESC, article_id \nDESC LIMIT 20.\n\n- composite index on (published_at,\n  article_id)",
      "autoResize": true,
      "lineHeight": 1.25
    },
