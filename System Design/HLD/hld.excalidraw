    {
      "id": "tB79RPelriCjFksZMnajV",
      "type": "text",
      "x": 7357.643330039912,
      "y": -787.8344516054397,
      "width": 1053.0791015625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "lJIwaj4kCQyYEbi6Zoqew",
        "Vxo1KAyUO7A6Y3UGGAg1j",
        "jyUeGa-diHEPzmKXMLAqY",
        "IQSW860ywbLS4hT70SALK"
      ],
      "frameId": null,
      "index": "b7rO",
      "roundness": null,
      "seed": 2057379273,
      "version": 344,
      "versionNonce": 843463713,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761702997386,
      "link": null,
      "locked": false,
      "text": "- 302 (Temporary redirect) - always ensures it goes through our server\n- 301 (Permanent redirect) - Browser cache response for first time and further visits will bypass our server",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 302 (Temporary redirect) - always ensures it goes through our server\n- 301 (Permanent redirect) - Browser cache response for first time and further visits will bypass our server",
      "autoResize": true,
      "lineHeight": 1.25
    },
