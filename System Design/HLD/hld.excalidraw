      "updated": 1762661179113,
      "link": null,
      "locked": false,
      "text": "3.1 Create Auction\n\nPOST /auctions -> Auction & Item\n{\n    item: Item,\n    startDate: Date,\n    endDate: Date,\n    startingPrice: number\n}\n\n3.2 Create bid\n\nPOST /auctions/:auctionId/bids -> Bid\n{\n    Bid\n}\n\n3.3 View Auction\n\nGET /auctions/:auctionId -> Auction & Item\n",
      "fontSize": 20.584857219536815,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.1 Create Auction\n\nPOST /auctions -> Auction & Item\n{\n    item: Item,\n    startDate: Date,\n    endDate: Date,\n    startingPrice: number\n}\n\n3.2 Create bid\n\nPOST /auctions/:auctionId/bids -> Bid\n{\n    Bid\n}\n\n3.3 View Auction\n\nGET /auctions/:auctionId -> Auction & Item\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
