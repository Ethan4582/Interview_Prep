      "boundElements": [],
      "updated": 1761791445273,
      "link": null,
      "locked": false,
      "text": "1. some time in the past, Person A swiped right on Person B and we persisted\nthis in our Swipe DB\n2. person B swipes right on Person A\n3. The server checks for inverse swipe and finds that it does exist.\n4. We display \"matched\" to Person B immediately\n5. Send push notification via APNS or FCM to Person A",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. some time in the past, Person A swiped right on Person B and we persisted\nthis in our Swipe DB\n2. person B swipes right on Person A\n3. The server checks for inverse swipe and finds that it does exist.\n4. We display \"matched\" to Person B immediately\n5. Send push notification via APNS or FCM to Person A",
      "autoResize": true,
      "lineHeight": 1.25
    },
