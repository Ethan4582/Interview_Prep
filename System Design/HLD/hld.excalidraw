    {
      "id": "wYKUaAu3U5M35HLlRGiRG",
      "type": "text",
      "x": 52159.70102155153,
      "y": -209.26033540925528,
      "width": 844.798828125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c01t",
      "roundness": null,
      "seed": 1541711727,
      "version": 589,
      "versionNonce": 1470427439,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761710665862,
      "link": null,
      "locked": false,
      "text": "- The click processor service writes the event to stream like kinesis/kafka\n- A stream processor like Flink/Spark Streaming reads the events from the stream and aggregates \nthem in real-time\n- The aggregated data is stored in OLAP database for querying\n- Advertisers can query OLAP database to get metrics on their ads\nin near real time\n\n- Flink even has flush intervals : meaning we can aggregate on a minute\nboundary but flush the results every couple of seconds.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The click processor service writes the event to stream like kinesis/kafka\n- A stream processor like Flink/Spark Streaming reads the events from the stream and aggregates \nthem in real-time\n- The aggregated data is stored in OLAP database for querying\n- Advertisers can query OLAP database to get metrics on their ads\nin near real time\n\n- Flink even has flush intervals : meaning we can aggregate on a minute\nboundary but flush the results every couple of seconds.",
      "autoResize": true,
      "lineHeight": 1.25
    },
