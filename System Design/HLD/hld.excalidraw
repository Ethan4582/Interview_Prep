    {
      "id": "_XQ8motr30Fk4FLyx5bPH",
      "type": "text",
      "x": 48039.315678761086,
      "y": 7195.694501387967,
      "width": 649,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c04G",
      "roundness": null,
      "seed": 156635809,
      "version": 289,
      "versionNonce": 1551088225,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761713269076,
      "link": null,
      "locked": false,
      "text": "- Already streaming approach or batch processing approach\nsolves pre-aggregating data way before.\n- Still we can maintain separate table like daily or weekly\n(running nightly cron job) for high level granularity",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Already streaming approach or batch processing approach\nsolves pre-aggregating data way before.\n- Still we can maintain separate table like daily or weekly\n(running nightly cron job) for high level granularity",
      "autoResize": true,
      "lineHeight": 1.25
    },
