      "versionNonce": 687477583,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761661070356,
      "link": null,
      "locked": false,
      "text": "- Currently we are querying periodically to pick the jobs to be executed\n- With 10k jobs/sec for every 2s we need to process around 20K jobs - Huge payload to process\n- More latency - querying 20K jobs (huge load on database), \ninitialising them and distributing to workers and begin execution",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Currently we are querying periodically to pick the jobs to be executed\n- With 10k jobs/sec for every 2s we need to process around 20K jobs - Huge payload to process\n- More latency - querying 20K jobs (huge load on database), \ninitialising them and distributing to workers and begin execution",
      "autoResize": true,
      "lineHeight": 1.25
    },
