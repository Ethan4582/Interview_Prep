      "updated": 1761659375873,
      "link": null,
      "locked": false,
      "text": "3.1 Create a Job\n\nPOST /jobs\n{\n    \"task_id\": \"send_welcome_email\",\n    \"schedule\": \"0 10 * * *\",\n    \"parameters\": {\n        \"to\": \"abc@gmail.com\",\n        \"subject\": \"Welcome to ABC\"\n    }\n}\n\n\n3.2 Query status of Jobs\n\nGET /jobs?user_id={user_id}&status={status}&start_time={start_time}&end_time={end_time} -> Job[]",
      "fontSize": 20.584857219536815,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.1 Create a Job\n\nPOST /jobs\n{\n    \"task_id\": \"send_welcome_email\",\n    \"schedule\": \"0 10 * * *\",\n    \"parameters\": {\n        \"to\": \"abc@gmail.com\",\n        \"subject\": \"Welcome to ABC\"\n    }\n}\n\n\n3.2 Query status of Jobs\n\nGET /jobs?user_id={user_id}&status={status}&start_time={start_time}&end_time={end_time} -> Job[]",
      "autoResize": true,
      "lineHeight": 1.25
    },
