      "text": "- Why 302 redirect instead of 301 redirect ??",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Why 302 redirect instead of 301 redirect ??",
