    },
    {
      "id": "1Y2sc7k61qrOvamtjVt03",
      "type": "text",
      "x": 79751.46795881109,
      "y": 276.8084218034469,
      "width": 572,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Qr",
