    },
    {
      "id": "-nKJA4i_GDPYXVCzAuyWR",
      "type": "text",
      "x": 104977.24687708201,
      "y": -807.9433516781199,
      "width": 330,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0hG",
      "roundness": null,
      "seed": 1869532251,
      "version": 59,
      "versionNonce": 2000591163,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762834445927,
      "link": null,
      "locked": false,
      "text": "1. Filter by country\n - \"leaderboard:run:<country>\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Filter by country\n - \"leaderboard:run:<country>\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2rR9KkQWCMr_exoKo806q",
      "type": "text",
      "x": 104996.2536389878,
      "y": -710.005371162286,
      "width": 814,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0hH",
      "roundness": null,
      "seed": 2075117179,
      "version": 15,
      "versionNonce": 1637216379,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762834489454,
      "link": null,
      "locked": false,
      "text": "# Add an activity to the leaderboard (increment user's total distance)\nredis.zincrby(f\"leaderboard:run:global\", distance, user_id)\nredis.zincrby(f\"leaderboard:run:<country>\", distance, user_id)\n\n# Query the leaderboard (get top users by total distance)\nredis.zrange(f\"leaderboard:run:global\", 0, -1, desc=True, withscores=True)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Add an activity to the leaderboard (increment user's total distance)\nredis.zincrby(f\"leaderboard:run:global\", distance, user_id)\nredis.zincrby(f\"leaderboard:run:<country>\", distance, user_id)\n\n# Query the leaderboard (get top users by total distance)\nredis.zrange(f\"leaderboard:run:global\", 0, -1, desc=True, withscores=True)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jmydYs-xRbNwiDg4rwCcP",
      "type": "text",
      "x": 104976.41711394287,
      "y": -501.1799191405187,
      "width": 242,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0hI",
      "roundness": null,
      "seed": 934201877,
      "version": 30,
      "versionNonce": 640324789,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762834568452,
      "link": null,
      "locked": false,
      "text": "2. Filter by timestamp\n\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Filter by timestamp\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y60PZ84KCvspuutLWIxDu",
      "type": "text",
      "x": 104997.6383062262,
      "y": -408.59909689171445,
      "width": 979,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0hJ",
      "roundness": null,
      "seed": 1222290293,
      "version": 3,
      "versionNonce": 1619919765,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762834573630,
      "link": null,
      "locked": false,
      "text": "# When logging a new activity\nactivity_id = generate_unique_id()\nredis.zadd(\"activities:timestamps\", {activity_id: timestamp})\nredis.hset(f\"activity:{activity_id}\", mapping={\"user_id\": user_id, \"distance\": distance})\n\n# Querying the leaderboard for last 24 hours\nnow = current_timestamp()\nday_ago = now - 24*60*60\nactivity_ids = redis.zrangebyscore(\"activities:timestamps\", day_ago, now)\n\nuser_distances = {}\nfor activity_id in activity_ids:\n    activity_data = redis.hgetall(f\"activity:{activity_id}\")\n    user_id = activity_data[\"user_id\"]\n    distance = float(activity_data[\"distance\"])\n    user_distances[user_id] = user_distances.get(user_id, 0) + distance\n\n# Sort users by total distance\nleaderboard = sorted(user_distances.items(), key=lambda x: x[1], reverse=True)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# When logging a new activity\nactivity_id = generate_unique_id()\nredis.zadd(\"activities:timestamps\", {activity_id: timestamp})\nredis.hset(f\"activity:{activity_id}\", mapping={\"user_id\": user_id, \"distance\": distance})\n\n# Querying the leaderboard for last 24 hours\nnow = current_timestamp()\nday_ago = now - 24*60*60\nactivity_ids = redis.zrangebyscore(\"activities:timestamps\", day_ago, now)\n\nuser_distances = {}\nfor activity_id in activity_ids:\n    activity_data = redis.hgetall(f\"activity:{activity_id}\")\n    user_id = activity_data[\"user_id\"]\n    distance = float(activity_data[\"distance\"])\n    user_distances[user_id] = user_distances.get(user_id, 0) + distance\n\n# Sort users by total distance\nleaderboard = sorted(user_distances.items(), key=lambda x: x[1], reverse=True)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Gs5jQetA69n9wYXaRgoxK",
      "type": "rectangle",
      "x": 104959.5968256228,
      "y": 308.3454889361724,
      "width": 184.7998146902826,
