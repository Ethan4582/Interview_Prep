      "isDeleted": false,
      "boundElements": [],
      "updated": 1761809338751,
      "link": null,
      "locked": false,
      "text": "Functional :\n- should be able to view list of problems\n- View given problem and code solution in multiple languages\n- Submit solution and get instant feedback\n- live leaderboard for competitions\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- should be able to view list of problems\n- View given problem and code solution in multiple languages\n- Submit solution and get instant feedback\n- live leaderboard for competitions\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XpfNQxo8swLsGzL_bvjQl",
      "type": "text",
      "x": 68374.9172907894,
      "y": -6008.9389717268605,
      "width": 498.4796142578125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
