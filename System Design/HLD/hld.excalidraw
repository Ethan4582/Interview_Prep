      "type": "text",
      "x": 41128.96497321926,
      "y": -1506.299482712275,
      "width": 818.3988647460938,
      "height": 80,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
