      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bri",
      "roundness": null,
      "seed": 1094863567,
      "version": 38,
      "versionNonce": 1402613103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761643822659,
      "link": null,
      "locked": false,
