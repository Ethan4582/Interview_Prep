      "link": null,
      "locked": false,
      "text": "3.1 Query Availability\n\n    GET /availability?lat={}&long={}&keyword={}&page_size={}&page_num{} ->\n    {\n        items: {\n            name,\n            quantity\n        }[]\n    }",
      "fontSize": 20,
      "fontFamily": 5,
