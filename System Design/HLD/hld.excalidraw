      "versionNonce": 1168523566,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762661203717,
      "link": null,
      "locked": false,
      "text": "Functional :\n- should be able to post an item for auction with starting price and end date.\n- should be able to bid on an item: bids are accepted if > current highest bid.\n- should be able to view auction, including current highest bid\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- should be able to post an item for auction with starting price and end date.\n- should be able to bid on an item: bids are accepted if > current highest bid.\n- should be able to view auction, including current highest bid\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NvkI4S8oa6Ncg6DZFSB1N",
      "type": "text",
      "x": 77988.31209498926,
      "y": -6113.727946675508,
      "width": 591.4395751953125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "4XXguPHZD84rD2nbdDqCO"
      ],
      "frameId": null,
      "index": "c0Oe",
