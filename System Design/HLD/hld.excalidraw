      "updated": 1761629721076,
      "link": null,
      "locked": false,
      "text": "- Each server will have its own rate limiting built directly\ninto its application code\n- Directly checks its local memory counters and decides to allow or not,\nsuper fast as no network calls or external dependencies.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Each server will have its own rate limiting built directly\ninto its application code\n- Directly checks its local memory counters and decides to allow or not,\nsuper fast as no network calls or external dependencies.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wyQnbYasr3DnkluNU5oad",
      "type": "text",
      "x": 34847.03338651406,
      "y": -2970.727938424645,
      "width": 659.9990844726562,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bp5",
