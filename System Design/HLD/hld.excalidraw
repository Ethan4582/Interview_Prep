    {
      "id": "Y2b6pY2Ma4xXZtohiBRac",
      "type": "text",
      "x": 49781.3716538446,
      "y": 45.21160472328029,
      "width": 950.398681640625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
