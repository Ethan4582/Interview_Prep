    },
    {
      "id": "m_ZIwZkAJTP8mOk2c72pB",
      "type": "text",
      "x": 57114.202125424024,
      "y": 4009.385173019597,
      "width": 946,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
