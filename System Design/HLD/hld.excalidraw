    {
      "id": "DIe-eQ7rD6okcyWh-n6P6",
      "type": "text",
      "x": 62053.22335740023,
      "y": -268.60316816467036,
      "width": 693,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0CD",
      "roundness": null,
      "seed": 1245510773,
      "version": 6,
      "versionNonce": 2103939925,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761796997543,
      "link": null,
      "locked": false,
      "text": "1. CREATE TABLE swipes (\n    user_pair text,      -- partition key: smaller_id:larger_id\n    from_user uuid,      -- clustering key\n    to_user uuid,        -- clustering key\n    direction text,\n    created_at timestamp,\n    PRIMARY KEY ((user_pair), from_user, to_user)\n);",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. CREATE TABLE swipes (\n    user_pair text,      -- partition key: smaller_id:larger_id\n    from_user uuid,      -- clustering key\n    to_user uuid,        -- clustering key\n    direction text,\n    created_at timestamp,\n    PRIMARY KEY ((user_pair), from_user, to_user)\n);",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VseskJUCSkM76x9adSJpp",
      "type": "text",
      "x": 62065.253098621986,
      "y": -20.60542605456112,
      "width": 935,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0CE",
      "roundness": null,
      "seed": 1539024475,
      "version": 7,
      "versionNonce": 1653422075,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761797025277,
      "link": null,
      "locked": false,
      "text": "2. def get_user_pair(user_a, user_b):\n    # Sort IDs so (A->B) and (B->A) are in same partition\n    sorted_ids = sorted([user_a, user_b])\n    return f\"{sorted_ids[0]}:{sorted_ids[1]}\"\n\n    def handle_swipe(from_user, to_user, direction):\n        user_pair = get_user_pair(from_user, to_user)\n        \n        # Both operations happen atomically in same partition\n        batch = \"\"\"\n        BEGIN BATCH\n            INSERT INTO swipes (user_pair, from_user, to_user, direction, created_at)\n            VALUES (?, ?, ?, ?, ?);\n            \n            SELECT direction FROM swipes \n            WHERE user_pair = ? \n            AND from_user = ? \n            AND to_user = ?;\n        APPLY BATCH;\n        \"\"\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. def get_user_pair(user_a, user_b):\n    # Sort IDs so (A->B) and (B->A) are in same partition\n    sorted_ids = sorted([user_a, user_b])\n    return f\"{sorted_ids[0]}:{sorted_ids[1]}\"\n\n    def handle_swipe(from_user, to_user, direction):\n        user_pair = get_user_pair(from_user, to_user)\n        \n        # Both operations happen atomically in same partition\n        batch = \"\"\"\n        BEGIN BATCH\n            INSERT INTO swipes (user_pair, from_user, to_user, direction, created_at)\n            VALUES (?, ?, ?, ?, ?);\n            \n            SELECT direction FROM swipes \n            WHERE user_pair = ? \n            AND from_user = ? \n            AND to_user = ?;\n        APPLY BATCH;\n        \"\"\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
