      "link": null,
      "locked": false,
      "text": "3.1 Shorten a URL\n\n    POST /short_url\n    {\n        \"long_url\": \"https://www.app.openstudio.tech/studio\",\n        \"custom_alias\": \"openstudio\",\n        \"expiration_date\": \"2025-11-11\"\n    } -> {\n        \"short_url\": \"https://os.ly/openstudio\"\n    }",
