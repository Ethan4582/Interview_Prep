      "updated": 1761016126353,
      "link": null,
      "locked": false,
      "text": "Functional :\n- View events\n- search for events\n- book tickets to events\n- View booked events\n- Admin flows (adding/editing/..)\n- dynamic pricing for popular events\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- View events\n- search for events\n- book tickets to events\n- View booked events\n- Admin flows (adding/editing/..)\n- dynamic pricing for popular events\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
