      "frameId": null,
      "index": "brG",
      "roundness": null,
      "seed": 1046501999,
      "version": 365,
      "versionNonce": 630253089,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761637839860,
      "link": null,
      "locked": false,
      "text": "- Hybrid - Sliding Window +\n            Fixed Window\n- Maintaining - Prev window count and\nCurrent window count\n- Whenever request comes in, lets say\nwe're 30% into current minute.\n    - Then count 70% of previous window\n      as it still overlaps with 60 sec\n      window + 100% of current window",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Hybrid - Sliding Window +\n            Fixed Window\n- Maintaining - Prev window count and\nCurrent window count\n- Whenever request comes in, lets say\nwe're 30% into current minute.\n    - Then count 70% of previous window\n      as it still overlaps with 60 sec\n      window + 100% of current window",
      "autoResize": true,
      "lineHeight": 1.25
    },
