      "seed": 1494328853,
      "version": 2979,
      "versionNonce": 1780918574,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762665956948,
      "link": null,
      "locked": false,
      "text": "Non-Functional :\n- strong consistency for bids so users see same highest bid.\n- fault tolerant and durable, can't afford to drop bids.\n- real time display of current highest bid.\n- handle 10M concurrent auctions.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional :\n- strong consistency for bids so users see same highest bid.\n- fault tolerant and durable, can't afford to drop bids.\n- real time display of current highest bid.\n- handle 10M concurrent auctions.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
