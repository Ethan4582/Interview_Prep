    },
    {
      "id": "S2MpFEdC8FoJz1SPlg8Qc",
      "type": "text",
      "x": 128990.06113687629,
      "y": -10034.036845211813,
      "width": 653.2796020507812,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jc1EugunywtBiaYFT8LIY",
        "oobPOzALXPw7xHIfe4hDa"
      ],
      "frameId": null,
      "index": "c0oL",
      "roundness": null,
      "seed": 2104556294,
      "version": 4571,
      "versionNonce": 1663180592,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763090052174,
      "link": null,
      "locked": false,
      "text": "Functional :\n- should be able to start group chats with multiple participants\n- should be able to send/receive messages.\n- should be able to receive messages sent while they are not online\n- should be able to send/receive media in their messages",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- should be able to start group chats with multiple participants\n- should be able to send/receive messages.\n- should be able to receive messages sent while they are not online\n- should be able to send/receive media in their messages",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "q16SPXB0WJS9yj18b6wZA",
      "type": "text",
      "x": 128991.95066021805,
      "y": -9801.925901419698,
      "width": 447.01971435546875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "9fPBvfAB8iJFtCG3h-Ecy",
        "oobPOzALXPw7xHIfe4hDa"
      ],
      "frameId": null,
      "index": "c0oM",
      "roundness": null,
      "seed": 2095557190,
      "version": 3707,
      "versionNonce": 2078261200,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763092546221,
      "link": null,
      "locked": false,
      "text": "Non-Functional :\n- message delivery with low latency (< 500ms)\n- guarantee message delivery\n- handle B+ users with high throughput\n- Fault tolerant and handle multiple devices\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional :\n- message delivery with low latency (< 500ms)\n- guarantee message delivery\n- handle B+ users with high throughput\n- Fault tolerant and handle multiple devices\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
