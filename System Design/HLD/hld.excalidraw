      "versionNonce": 208453531,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761803179301,
      "link": null,
      "locked": false,
      "text": "3.1 List Problems\n\nGET /problems?page=1&limit=100 -> Partial<Problem>[]\n\n\n3.2 View Problem\n\nGET /problems/:id?language={language} -> Problem\n\n3.3 Submit Solution\n\nPOST /problems/:id/submit -> Submission\n{\n    \"code\": string,\n    \"language\": string\n}\n\n3.4 View Live leaderboard\n\nGET /leaderboard/:competitionId?page=1&limit=100 -> Leaderboard",
      "fontSize": 20.584857219536815,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.1 List Problems\n\nGET /problems?page=1&limit=100 -> Partial<Problem>[]\n\n\n3.2 View Problem\n\nGET /problems/:id?language={language} -> Problem\n\n3.3 Submit Solution\n\nPOST /problems/:id/submit -> Submission\n{\n    \"code\": string,\n    \"language\": string\n}\n\n3.4 View Live leaderboard\n\nGET /leaderboard/:competitionId?page=1&limit=100 -> Leaderboard",
      "autoResize": true,
      "lineHeight": 1.25
    },
