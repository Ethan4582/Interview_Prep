    {
      "id": "wIS5JS5aAPDuxHOlMZDLE",
      "type": "text",
      "x": 101764.17540920756,
      "y": -7877.28651516195,
      "width": 995.2276611328125,
      "height": 849.1253603058937,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "d_cm-OZwQBqhcCPvz72Ll"
      ],
      "frameId": null,
      "index": "c0ek",
      "roundness": null,
      "seed": 300200053,
      "version": 4427,
      "versionNonce": 181119899,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762826738823,
      "link": null,
      "locked": false,
      "text": "3.1 Create new activity\n\nPOST /activities -> Activity\n{\n    type: \"RUN\" | \"RIDE\"\n}\n\n\n3.2 Update Activity\n\nPATCH /activities/:activityId -> Activity\n{\n    state: \"STARTED\" | \"PAUSED\"\n}\n\n3.3 Update Activity routes\n\nPOST /activities/:activityId/routes -> Activity\n{\n    location: GPSCoordinate\n}\n\n3.4 List activities for user\n\nGET /activities?mode={USER|FRIENDS}&page={page}&pageSize={pageSize} -> Partial<Activity>[]\n\n3.5 View Activity\n\nGET /activities/:activityId -> Activity\n\n\n\n",
      "fontSize": 20.584857219536815,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.1 Create new activity\n\nPOST /activities -> Activity\n{\n    type: \"RUN\" | \"RIDE\"\n}\n\n\n3.2 Update Activity\n\nPATCH /activities/:activityId -> Activity\n{\n    state: \"STARTED\" | \"PAUSED\"\n}\n\n3.3 Update Activity routes\n\nPOST /activities/:activityId/routes -> Activity\n{\n    location: GPSCoordinate\n}\n\n3.4 List activities for user\n\nGET /activities?mode={USER|FRIENDS}&page={page}&pageSize={pageSize} -> Partial<Activity>[]\n\n3.5 View Activity\n\nGET /activities/:activityId -> Activity\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
