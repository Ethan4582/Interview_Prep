      "link": null,
      "locked": false,
      "text": "- Configurable exponential backoff\nout of the box\n(ex: visibility timeout of 15 seconds,\n2m, 5m and upto 15m) and after that\nwill be move DLQ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Configurable exponential backoff\nout of the box\n(ex: visibility timeout of 15 seconds,\n2m, 5m and upto 15m) and after that\nwill be move DLQ",
      "autoResize": true,
      "lineHeight": 1.25
    },
