      "seed": 315874793,
      "version": 709,
      "versionNonce": 1272223829,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755326512814,
      "link": null,
      "locked": false,
      "text": "Non Functional :\n- availability >> consistency\n- support large files (e.g 100 GB)\n- should be secure and reliable\n- latency as less as possible",
