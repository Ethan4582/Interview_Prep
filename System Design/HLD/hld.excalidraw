      "updated": 1761720078667,
      "link": null,
      "locked": false,
      "text": "- Separate topic for failed URLs\nand a separate service that reads\nfrom this topic.\n- We could store the time that the \nnext fetch should occur in the \nmessage itself.\n- When consumer reads message, waits\nuntil that time to retry.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Separate topic for failed URLs\nand a separate service that reads\nfrom this topic.\n- We could store the time that the \nnext fetch should occur in the \nmessage itself.\n- When consumer reads message, waits\nuntil that time to retry.",
      "autoResize": true,
      "lineHeight": 1.25
    },
