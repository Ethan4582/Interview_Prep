    {
      "id": "H03EoRHsBPXn3GRN0MAdG",
      "type": "text",
      "x": 24482.211478593726,
      "y": -398.06268935270407,
      "width": 545.5992431640625,
      "height": 220,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "le50D3c4ojbLEljCZhiDz"
      ],
      "frameId": null,
      "index": "bce",
      "roundness": null,
      "seed": 446873318,
      "version": 885,
      "versionNonce": 1256702054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761019725501,
      "link": null,
      "locked": false,
      "text": "- Lock specific ticket row by adding a status when user clicks\non ticket (reserved) and expiration time on ticket table\n\nUnlocking??\n- If user purchased, status changed to \"booked\" \nand database lock is released.\n- If user delay or abandon it, a cron job resets \nexpired “reserved” entries to “available”. But still\nthere will be lag bw elapsed time and time the row is\nchanged, not ideal for popular events.\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Lock specific ticket row by adding a status when user clicks\non ticket (reserved) and expiration time on ticket table\n\nUnlocking??\n- If user purchased, status changed to \"booked\" \nand database lock is released.\n- If user delay or abandon it, a cron job resets \nexpired “reserved” entries to “available”. But still\nthere will be lag bw elapsed time and time the row is\nchanged, not ideal for popular events.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
