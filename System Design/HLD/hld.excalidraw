    {
      "id": "9igVQSJlJT9awUwW4ZHDm",
      "type": "text",
      "x": 102373.31048100392,
      "y": -329.467384286576,
      "width": 902,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "wtXf61Ir5U_-5Hp30VpAx",
        "QghOAzwvcFCc0kW7RQrsl"
      ],
      "frameId": null,
      "index": "c0h8",
      "roundness": null,
      "seed": 1745036347,
      "version": 887,
      "versionNonce": 133984277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762834183765,
      "link": null,
      "locked": false,
      "text": "1. Use on-device location services to record user GPS Coordinates\n2. Record this event data locally in in-memory buffer\n3. To prevent loss in device shutdown or battery depletion, periodically\npersist this to device's local storage ~10 seconds\n    - ios: Core Data for larger datasets or UserDefaults for smaller amounts\n    - android: Room database for larger or SharedPreferences for smaller amounts\n4. Send accumulated data to our server in single request or in chunks or implement\nbackground sync mechanism\n5. Upon confirmation from remote database, clear on device local storage",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Use on-device location services to record user GPS Coordinates\n2. Record this event data locally in in-memory buffer\n3. To prevent loss in device shutdown or battery depletion, periodically\npersist this to device's local storage ~10 seconds\n    - ios: Core Data for larger datasets or UserDefaults for smaller amounts\n    - android: Room database for larger or SharedPreferences for smaller amounts\n4. Send accumulated data to our server in single request or in chunks or implement\nbackground sync mechanism\n5. Upon confirmation from remote database, clear on device local storage",
      "autoResize": true,
      "lineHeight": 1.25
    },
