    {
      "id": "N9VNZRksnllcOEjtevBcI",
      "type": "text",
      "x": 23926.00082582915,
      "y": 3110.2783842198796,
      "width": 307.99957275390625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
