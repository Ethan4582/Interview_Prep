    {
      "id": "ejf1nCTQTpQgKdlAchWYx",
      "type": "text",
      "x": 25252.68450781573,
      "y": -421.0671667504148,
      "width": 404.7994384765625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "JEgFfQd0t209nAP2AcqSe"
      ],
      "frameId": null,
      "index": "bcl",
      "roundness": null,
      "seed": 344150950,
      "version": 1380,
      "versionNonce": 1335743078,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761016126356,
      "link": null,
      "locked": false,
      "text": "- Now we check to see if the current ticket\nis either available or reserved but expired\n- Then we update the ticket to reserved with\nexpiration now +10 minutes.\n- This way ensures only one user will be able\nto reserve or book ticket and no wait time for\nusers from expired reservations.\n\n\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Now we check to see if the current ticket\nis either available or reserved but expired\n- Then we update the ticket to reserved with\nexpiration now +10 minutes.\n- This way ensures only one user will be able\nto reserve or book ticket and no wait time for\nusers from expired reservations.\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
