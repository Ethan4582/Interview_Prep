    },
    {
      "id": "KKYsMEJeBA5K8pci1qB7e",
      "type": "text",
      "x": 136442.3991859454,
      "y": -9400.593450564558,
      "width": 770,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "njKXtpW9Yrc1AQSDPiUd3"
      ],
      "frameId": null,
      "index": "c0sW",
      "roundness": null,
      "seed": 287270192,
      "version": 1435,
      "versionNonce": 1066634544,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763096176196,
      "link": null,
      "locked": false,
      "text": "3.1 Search for businesses\nGET /businesses?query={}&location={}&category={}&page={} -> Business[]\n\n\n3.2 View business details\nGET /businesses/:businessId -> Business & Review[]\n\n(OR)\n\nGET /businesses/:businessId -> Business\n\nGET /businesses/:businessId/reviews?page={} -> Review[]\n\n3.3 Leave a Review\nPOST /businesses/:businessId/reviews\n{\n    \"rating\": number,\n    \"text\": \"\"\n}\n",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.1 Search for businesses\nGET /businesses?query={}&location={}&category={}&page={} -> Business[]\n\n\n3.2 View business details\nGET /businesses/:businessId -> Business & Review[]\n\n(OR)\n\nGET /businesses/:businessId -> Business\n\nGET /businesses/:businessId/reviews?page={} -> Review[]\n\n3.3 Leave a Review\nPOST /businesses/:businessId/reviews\n{\n    \"rating\": number,\n    \"text\": \"\"\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
