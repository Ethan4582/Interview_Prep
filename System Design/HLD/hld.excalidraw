      "link": null,
      "locked": false,
      "text": "Functional :\n- viewers can post comments on live video feed.\n- viewers can see all comments in near realtime.\n- viewers can see all comments posted before they joined.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- viewers can post comments on live video feed.\n- viewers can see all comments in near realtime.\n- viewers can see all comments posted before they joined.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "scpc7SFEQEC2DtffHoaq5",
      "type": "text",
      "x": 111915.90226128775,
      "y": -8800.94241714731,
      "width": 438.39971923828125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "GSo7qhfbcZb0V2mi5KhbX",
        "njpxZ52hJ__8-eef01Rcs"
      ],
      "frameId": null,
      "index": "c0hld",
      "roundness": null,
      "seed": 19224730,
      "version": 3502,
      "versionNonce": 1983200646,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763084189527,
      "link": null,
      "locked": false,
      "text": "Non-Functional :\n- scale to millions of viewers per video.\n- availability >>> consistency\n- low latency comments broadcast (< 200ms)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional :\n- scale to millions of viewers per video.\n- availability >>> consistency\n- low latency comments broadcast (< 200ms)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
