    {
      "id": "VYP9QRgLY1ahfqEUeLiyD",
      "type": "text",
      "x": 78090.40217000787,
      "y": 4896.264271994166,
      "width": 1298,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Ta",
      "roundness": null,
      "seed": 1376809522,
      "version": 217,
      "versionNonce": 840592626,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762666375003,
      "link": null,
      "locked": false,
      "text": "- each auction has 100 bids -> 1B bids/day -> 1B / 100,000 = 10K bids/second\n- each auction maybe 1kb, each bid maybe 500 bytes\n- 10M * 52 = 520M auctions per year. That's 520M * (1kb + (0.5kb * 100 bids per auction)) = 25 TB of storage per year.\n- Database shard by auction id - for write throughput",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- each auction has 100 bids -> 1B bids/day -> 1B / 100,000 = 10K bids/second\n- each auction maybe 1kb, each bid maybe 500 bytes\n- 10M * 52 = 520M auctions per year. That's 520M * (1kb + (0.5kb * 100 bids per auction)) = 25 TB of storage per year.\n- Database shard by auction id - for write throughput",
      "autoResize": true,
      "lineHeight": 1.25
    },
