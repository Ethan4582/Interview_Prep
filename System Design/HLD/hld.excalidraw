    },
    {
      "id": "VyCUteHGfrcCq7Cm2dLq6",
      "type": "text",
      "x": 60736.39658149319,
      "y": -6105.773350024171,
      "width": 670.91943359375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "Pdkir4I8cCtyQUP8DH8YO"
      ],
      "frameId": null,
      "index": "c0A3",
      "roundness": null,
      "seed": 1447492527,
      "version": 2789,
      "versionNonce": 478915733,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761790050834,
      "link": null,
      "locked": false,
      "text": "Functional :\n- Users can create profile with preferences and specify max distance\n- Users recommended based off filters/location\n- Users can swipe left or right\n- Mutually swipe yes -> notification\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional :\n- Users can create profile with preferences and specify max distance\n- Users recommended based off filters/location\n- Users can swipe left or right\n- Mutually swipe yes -> notification\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OOYEmAqBi5srDQ3N0YMdZ",
      "type": "text",
      "x": 60738.6651415741,
      "y": -5873.535427597985,
      "width": 482.399658203125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ZUgCc0FPla1jARaIHwh7F"
      ],
      "frameId": null,
      "index": "c0A4",
      "roundness": null,
      "seed": 2053746127,
      "version": 2439,
      "versionNonce": 1635120821,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761789523406,
      "link": null,
      "locked": false,
      "text": "Non-Functional :\n- consistency for swipes\n- handle 20M DAU, ~100 swipes/user/day on avg.\n- low latency feed stack < 300ms\n- Avoid showing repeat profiles\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional :\n- consistency for swipes\n- handle 20M DAU, ~100 swipes/user/day on avg.\n- low latency feed stack < 300ms\n- Avoid showing repeat profiles\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
