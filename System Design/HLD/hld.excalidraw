    {
      "id": "Hl3P9JpY7e6zIRQ1duuS3",
      "type": "text",
      "x": 129021.41359688152,
      "y": -9246.37419838668,
      "width": 396,
      "height": 1225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "oobPOzALXPw7xHIfe4hDa"
      ],
      "frameId": null,
      "index": "c0oQ",
      "roundness": null,
      "seed": 1477793606,
      "version": 925,
      "versionNonce": 737714480,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763090052174,
      "link": null,
      "locked": false,
      "text": "3.1 Create Chat Command\n-> createChat\n{\n    \"participants\": [],\n    \"name\": \"\"\n} -> {\n    \"chatId\": \"\"\n}\n\n3.2 Send Message Command\n-> sendMessage\n{\n    \"chatId\": \"\",\n    \"message\": \"\",\n    \"attachments\": []\n} -> \"SUCCESS\" | \"FAILURE\"\n\n3.3 Create Attachment Command\n-> createAttachment\n{\n    \"body\": ...,\n    \"hash\": \"\"\n} -> {\n    \"attachmentId\": \"\"\n}\n\n3.4 Modify Chat Participants Command\n-> modifyChatParticipants\n{\n    \"chatId\": \"\",\n    \"userId\": \"\",\n    \"operation\": \"ADD\" | \"REMOVE\"\n} -> \"SUCCESS\" | \"FAILURE\"\n\n3.5 Chat Update Command\n<- chatUpdate\n{\n    \"chatId\": \"\",\n    \"participants\": [],\n} -> \"RECEIVED\"\n\n3.6 New Message Command\n<- newMessage\n{\n    \"chatId\": \"\",\n    \"userId\": \"\",\n    \"message\": \"\",\n    \"attachments\": []\n} -> \"RECEIVED\"",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.1 Create Chat Command\n-> createChat\n{\n    \"participants\": [],\n    \"name\": \"\"\n} -> {\n    \"chatId\": \"\"\n}\n\n3.2 Send Message Command\n-> sendMessage\n{\n    \"chatId\": \"\",\n    \"message\": \"\",\n    \"attachments\": []\n} -> \"SUCCESS\" | \"FAILURE\"\n\n3.3 Create Attachment Command\n-> createAttachment\n{\n    \"body\": ...,\n    \"hash\": \"\"\n} -> {\n    \"attachmentId\": \"\"\n}\n\n3.4 Modify Chat Participants Command\n-> modifyChatParticipants\n{\n    \"chatId\": \"\",\n    \"userId\": \"\",\n    \"operation\": \"ADD\" | \"REMOVE\"\n} -> \"SUCCESS\" | \"FAILURE\"\n\n3.5 Chat Update Command\n<- chatUpdate\n{\n    \"chatId\": \"\",\n    \"participants\": [],\n} -> \"RECEIVED\"\n\n3.6 New Message Command\n<- newMessage\n{\n    \"chatId\": \"\",\n    \"userId\": \"\",\n    \"message\": \"\",\n    \"attachments\": []\n} -> \"RECEIVED\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
