      "text": "{\n  \"query\": {\n    \"geo_bounding_box\": { \n      \"location\": {\n        \"top_left\": {\n          \"lat\": 42,\n          \"lon\": -72\n        },\n        \"bottom_right\": {\n          \"lat\": 40,\n          \"lon\": -74\n        }\n      }\n    }\n  }\n}",
