    {
      "id": "m7Gy1Vf1MzQpETadVprvk",
      "type": "text",
      "x": 60747.9717518784,
      "y": -5311.433075924045,
      "width": 503.73638916015625,
      "height": 566.0835735372624,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bK2DXz5XM6C-hntJKgmKa"
      ],
      "frameId": null,
      "index": "c0A8",
      "roundness": null,
      "seed": 1734921807,
      "version": 2804,
      "versionNonce": 985961115,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761789937450,
      "link": null,
      "locked": false,
      "text": "3.1 Create a Profile\n\nPOST /profile\n{\n    \"age_min\": 20,\n    \"age_max\": 30,\n    \"distance\": 10,\n    \"interestedIn\": \"female\" | \"male\" | \"both\",\n    ....\n}\n\n\n3.2 Get Feed\n\nGET /feed?lat={}&long={}&distance={} -> User[]\n\n3.3 Swiping\n\nPOST /swipe/{userId}\n{\n    \"decision\": \"yes\" | \"no\"\n}",
      "fontSize": 20.584857219536815,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.1 Create a Profile\n\nPOST /profile\n{\n    \"age_min\": 20,\n    \"age_max\": 30,\n    \"distance\": 10,\n    \"interestedIn\": \"female\" | \"male\" | \"both\",\n    ....\n}\n\n\n3.2 Get Feed\n\nGET /feed?lat={}&long={}&distance={} -> User[]\n\n3.3 Swiping\n\nPOST /swipe/{userId}\n{\n    \"decision\": \"yes\" | \"no\"\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
