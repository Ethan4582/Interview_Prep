    {
      "id": "YC-PkbIc5CKij6ZolCh5K",
      "type": "text",
      "x": 101840.85573619629,
      "y": -1677.9300973050822,
      "width": 891,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0gV",
      "roundness": null,
      "seed": 330437685,
      "version": 384,
      "versionNonce": 2001689333,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1762830413747,
      "link": null,
      "locked": false,
      "text": "- Websockets or SSE and using pub-sub to broadcast updates to friends is overkill\n- Simple Polling is ideal\n    - Updates are predictable likely every 2-5 seconds\n    - Real time precision isn't critical\n- Implement smart buffering system - Intentional lag displaying location\ndata by one or two update intervals",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Websockets or SSE and using pub-sub to broadcast updates to friends is overkill\n- Simple Polling is ideal\n    - Updates are predictable likely every 2-5 seconds\n    - Real time precision isn't critical\n- Implement smart buffering system - Intentional lag displaying location\ndata by one or two update intervals",
      "autoResize": true,
      "lineHeight": 1.25
    },
