    },
    {
      "id": "BLhzqC9CprOGBVp3vpnPY",
      "type": "text",
      "x": 6358.834287010562,
      "y": -2123.6481945375663,
      "width": 1053.0791015625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "8BFPRfdKgfCXDnxHkEu0U",
        "IQSW860ywbLS4hT70SALK"
      ],
      "frameId": null,
      "index": "b7r9V",
      "roundness": null,
      "seed": 685518119,
      "version": 217,
      "versionNonce": 1917446543,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1761702997386,
      "link": null,
      "locked": false,
      "text": "- 302 (Temporary redirect) - always ensures it goes through our server\n- 301 (Permanent redirect) - Browser cache response for first time and further visits will bypass our server",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 302 (Temporary redirect) - always ensures it goes through our server\n- 301 (Permanent redirect) - Browser cache response for first time and further visits will bypass our server",
      "autoResize": true,
      "lineHeight": 1.25
    },
