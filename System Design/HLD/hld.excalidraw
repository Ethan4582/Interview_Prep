      "link": null,
      "locked": false,
      "text": "- When worker receives message from \nqueue, SQS automatically makes that\nmessage invisible to other workers\nfor configurable period.\n- If worker processed successfully deletes \nit or else puts back on queue",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- When worker receives message from \nqueue, SQS automatically makes that\nmessage invisible to other workers\nfor configurable period.\n- If worker processed successfully deletes \nit or else puts back on queue",
      "autoResize": true,
      "lineHeight": 1.25
    },
