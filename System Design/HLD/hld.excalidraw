    {
      "id": "WV1ofyojrZjRvFIYC09AM",
      "type": "text",
      "x": 11149.87529696726,
      "y": 3121.0843282714295,
      "width": 325.59954833984375,
      "height": 180,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iHb0OrXBZM7K6PzAwhXFA"
      ],
      "frameId": null,
      "index": "bHH",
      "roundness": null,
      "seed": 579545796,
      "version": 391,
      "versionNonce": 782014076,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755266629710,
      "link": null,
      "locked": false,
      "text": "Why not single POST request??\n1. Web servers and clients \nhave timeout settings, for \n50GB file it easily exceeds \nthose timeouts\nEx: 50GB over 100 Mbps -> 1.11 hrs\n50 x 8 = 400 gb -> 400 x 1000 ->\n400,000 Mb -> 400,000 / 100 -> 4000\nseconds -> 4000/60 -> 66.67 minutes. ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why not single POST request??\n1. Web servers and clients \nhave timeout settings, for \n50GB file it easily exceeds \nthose timeouts\nEx: 50GB over 100 Mbps -> 1.11 hrs\n50 x 8 = 400 gb -> 400 x 1000 ->\n400,000 Mb -> 400,000 / 100 -> 4000\nseconds -> 4000/60 -> 66.67 minutes. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xTYrCd5SnJg91lG_F4sUi",
      "type": "text",
      "x": 11154.783074474968,
      "y": 3314.2597475432544,
      "width": 299.1995849609375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iHb0OrXBZM7K6PzAwhXFA"
      ],
      "frameId": null,
      "index": "bHI",
      "roundness": null,
      "seed": 1500831612,
      "version": 229,
      "versionNonce": 1614571260,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755266629710,
      "link": null,
      "locked": false,
      "text": "2. Most Browsers and Servers will \nhave limitation on size of request\npayload (max 2 GB), so can't \ntransfer such big files at once.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Most Browsers and Servers will \nhave limitation on size of request\npayload (max 2 GB), so can't \ntransfer such big files at once.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "93LayCI7Iiuwomyo4ES5v",
      "type": "text",
      "x": 11157.907486217826,
      "y": 3407.0088539333174,
      "width": 307.99957275390625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "iHb0OrXBZM7K6PzAwhXFA"
      ],
      "frameId": null,
      "index": "bHJ",
      "roundness": null,
      "seed": 1496864892,
      "version": 194,
      "versionNonce": 1586374524,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755266629710,
      "link": null,
      "locked": false,
      "text": "3. Network Interruptions, user have\nto start from scratch again.\n4. Very bad user experience",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Network Interruptions, user have\nto start from scratch again.\n4. Very bad user experience",
      "autoResize": true,
      "lineHeight": 1.25
    },
