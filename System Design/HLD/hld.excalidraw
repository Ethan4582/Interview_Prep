      "isDeleted": false,
      "boundElements": [],
      "updated": 1762996871559,
      "link": null,
      "locked": false,
      "text": "- Layer 7 can leverage consistent hashing based on\nthe liveVideoId\n- Tools like NGINX can be scripted with Lua to achieve\ncontent-based routing",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Layer 7 can leverage consistent hashing based on\nthe liveVideoId\n- Tools like NGINX can be scripted with Lua to achieve\ncontent-based routing",
      "autoResize": true,
      "lineHeight": 1.25
    },
